# Pares assinados no producer (minúsculo, formato Binance)
SYMBOLS=btcusdt,ethusdt,solusdt,bnbusdt,xrpusdt

# Brokers Kafka expostos no host pelo docker-compose (3 brokers)
KAFKA_BOOTSTRAP=localhost:9092,localhost:9094,localhost:9096
TOPIC=crypto.trades

# Endpoint de market data da Binance (sem auth, combined stream)
BINANCE_WS_BASE=wss://data-stream.binance.vision/stream

# Camadas medallion (troca por s3://seu-bucket/... na fase AWS)
BRONZE_PATH=./data/bronze
SILVER_PATH=./data/silver
GOLD_PATH=./data/gold

# Política de flush do consumer batch: grava quando bater um dos dois
BATCH_MAX_MESSAGES=500
BATCH_MAX_SECONDS=30

# --- Fase AWS (opcional) ---
# Preenche só quando for subir o bronze pro S3. Deixa em branco = pipeline
# roda 100% local, sem nenhuma chamada pra AWS.
# 1. Troca BRONZE_PATH acima por: s3://seu-bucket/bronze
# 2. Cola aqui o access key/secret de um IAM user com permissão só nesse bucket.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
